                            <rect x="274" y="74" width="160" height="88" rx="22" fill="white" fill-opacity="0.94" stroke="#E5E8EE"/>
                            <rect x="294" y="94" width="102" height="14" rx="7" fill="#FFF1EC"/>
                            <rect x="294" y="118" width="120" height="14" rx="7" fill="#F5F7FF"/>
                            <rect x="294" y="142" width="76" height="12" rx="6" fill="#FFE1D7"/>

                            <rect x="274" y="182" width="160" height="70" rx="22" fill="white" fill-opacity="0.92" stroke="#E4E8EF"/>
