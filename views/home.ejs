                    <div class="info-list">
                        <div class="info-card">
                            <strong>Students</strong>
                            <span>Share assignment links, project submissions, and reference material in a cleaner format.</span>
                        </div>
                        <div class="info-card">
                            <strong>Developers</strong>
                            <span>Turn long Render, Vercel, and deployment URLs into links that are easier to send and remember.</span>
                        </div>
                        <div class="info-card">
                            <strong>WhatsApp and Telegram</strong>
                            <span>Make messages look cleaner by replacing bulky URLs with short, readable links.</span>
                        </div>
                        <div class="info-card">
                            <strong>Event organizers</strong>
                            <span>Share registration forms, schedules, and event pages with links that are quick to copy and easy to open.</span>
                        </div>
                    </div>
                </section>

                <section class="right-side">
                    <article class="card">
                        <h2>Account access</h2>
                        <p>Select an option below.</p>

                        <div class="switcher" role="tablist" aria-label="Authentication forms">
                            <button id="signup-tab" class="active" type="button" role="tab" aria-selected="true">Create Account</button>
                            <button id="login-tab" type="button" role="tab" aria-selected="false">Sign In</button>
                        </div>

                        <div class="panel-wrap">
                            <section id="signup-panel" class="auth-panel active" role="tabpanel" aria-labelledby="signup-tab">
                                <h3>Create account</h3>
                                <p>Complete the required fields.</p>

                                <form id="signup-form" class="form-grid" novalidate>
                                    <label class="field" for="signup-name">
                                        Name
                                        <input id="signup-name" name="name" type="text" placeholder="Enter your full name" required>
                                    </label>

                                    <label class="field" for="signup-email">
                                        Email
                                        <input id="signup-email" name="email" type="email" placeholder="you@example.com" required>
                                    </label>

                                    <label class="field" for="signup-userid">
                                        User ID
                                        <input id="signup-userid" name="user_id" type="text" placeholder="choose-a-user-id" required>
                                    </label>

                                    <label class="field" for="signup-password">
                                        Password
                                        <input id="signup-password" name="password" type="password" placeholder="Create a password" required>
                                    </label>

                                    <button type="submit" class="submit-button">Create Account</button>
                                </form>

                                <p id="signup-status" class="status" role="status" aria-live="polite"></p>
                            </section>

                            <section id="login-panel" class="auth-panel" role="tabpanel" aria-labelledby="login-tab">
                                <h3>Sign in</h3>
                                <p>Use your registered credentials.</p>

                                <form id="login-form" class="form-grid" novalidate>
                                    <label class="field" for="login-identifier">
                                        Email or User ID
                                        <input id="login-identifier" name="identifier" type="text" placeholder="Enter email or user id" required>
                                    </label>

                                    <label class="field" for="login-password">
                                        Password
                                        <input id="login-password" name="password" type="password" placeholder="Enter your password" required>
                                    </label>

                                    <button type="submit" class="submit-button">Sign In</button>
                                </form>

                                <p id="login-status" class="status" role="status" aria-live="polite"></p>
                            </section>
                        </div>
                    </article>
                </section>
            </div>
        </section>

        <section id="dashboard-view" class="view-shell" hidden>
            <div class="dashboard-grid">
                <section class="dashboard-side">
                    <div>
                        <div class="top-row">
                            <span class="pill">Dashboard</span>
                            <button id="logout-button" type="button" class="secondary-button">Sign Out</button>
                        </div>

                        <h1 class="dashboard-title">Create, track &amp; manage your short links <span class="title-tail">in seconds &#9889;</span></h1>
                        <p class="intro-copy">
                            Shorten long URLs, keep sharing clean, and monitor performance from one simple workspace.
                        </p>
                    </div>

                    <div class="dashboard-visual" aria-hidden="true">
                        <svg viewBox="0 0 520 300" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <linearGradient id="projectGlow" x1="68" y1="38" x2="440" y2="268" gradientUnits="userSpaceOnUse">
                                    <stop stop-color="#FF7447" stop-opacity="0.2"/>
