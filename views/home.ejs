<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shorten URL</title>
    <style>
        :root {
            --bg-main: #f7f1e8;
            --bg-soft: #fffaf5;
            --panel: rgba(255, 255, 255, 0.8);
            --panel-strong: rgba(255, 255, 255, 0.94);
            --border: rgba(23, 30, 37, 0.1);
            --text: #1b232c;
            --muted: #68737e;
            --accent: #ff6a3d;
            --accent-deep: #df4f25;
            --success: #1f7a5f;
            --danger: #c24a30;
            --shadow: 0 28px 90px rgba(72, 45, 26, 0.14);
            --radius-xl: 34px;
            --radius-lg: 24px;
            --radius-md: 18px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            padding: 22px;
            font-family: "Segoe UI", "Trebuchet MS", sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at top left, rgba(255, 184, 128, 0.42), transparent 30%),
                radial-gradient(circle at bottom right, rgba(95, 143, 255, 0.16), transparent 26%),
                linear-gradient(145deg, var(--bg-main), var(--bg-soft));
        }

        a {
            color: inherit;
        }

        button,
        input {
            font: inherit;
        }

        .page {
            width: min(1120px, 100%);
            margin: 0 auto;
        }

        .shell {
            position: relative;
            overflow: hidden;
            background: var(--panel);
            border: 1px solid rgba(255, 255, 255, 0.74);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow);
            backdrop-filter: blur(14px);
        }

        .shell::before,
        .shell::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .shell::before {
            width: 260px;
            height: 260px;
            top: -110px;
            right: -80px;
            background: radial-gradient(circle, rgba(255, 106, 61, 0.22), rgba(255, 106, 61, 0));
        }

        .shell::after {
            width: 220px;
            height: 220px;
            bottom: -110px;
            left: -70px;
            background: radial-gradient(circle, rgba(95, 143, 255, 0.16), rgba(95, 143, 255, 0));
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1.08fr;
            min-height: 760px;
        }

        .intro,
        .workspace {
            padding: 40px;
        }

        .intro {
            border-right: 1px solid rgba(27, 35, 44, 0.08);
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            gap: 36px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            width: fit-content;
            padding: 10px 16px;
            border-radius: 999px;
            background: rgba(27, 35, 44, 0.06);
            color: var(--muted);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        h1,
        h2,
        h3 {
            margin: 0;
            font-family: Georgia, "Times New Roman", serif;
            letter-spacing: -0.05em;
        }

        h1 {
            margin-top: 22px;
            font-size: clamp(3rem, 8vw, 5.6rem);
            line-height: 0.93;
            max-width: 8ch;
        }

        .intro-copy {
            margin: 18px 0 0;
            max-width: 44ch;
            color: var(--muted);
            font-size: 1.02rem;
            line-height: 1.75;
        }

        .info-cards {
            display: grid;
            gap: 14px;
        }

        .info-card {
            padding: 18px 20px;
            border-radius: var(--radius-lg);
            background: rgba(255, 255, 255, 0.58);
            border: 1px solid rgba(27, 35, 44, 0.07);
        }

        .info-card strong {
            display: block;
            margin-bottom: 6px;
            font-size: 1rem;
        }

        .info-card span {
            color: var(--muted);
            line-height: 1.6;
        }

        .workspace {
            display: grid;
            gap: 18px;
            align-content: start;
        }

        .panel {
            position: relative;
            z-index: 1;
            padding: 28px;
            border-radius: 28px;
            background: var(--panel-strong);
            border: 1px solid var(--border);
        }

        .panel p {
            margin: 12px 0 0;
            color: var(--muted);
            line-height: 1.65;
        }

        .form-grid {
            display: grid;
            gap: 14px;
            margin-top: 22px;
        }

        .field {
            display: grid;
            gap: 8px;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--muted);
        }

        .field input {
            width: 100%;
            padding: 17px 18px;
            border-radius: var(--radius-md);
            border: 1px solid rgba(27, 35, 44, 0.12);
            background: #fff;
            color: var(--text);
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .field input:focus {
            outline: none;
            border-color: rgba(255, 106, 61, 0.45);
            box-shadow: 0 0 0 5px rgba(255, 106, 61, 0.12);
            transform: translateY(-1px);
        }

        .button-row,
        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        .primary-button,
        .ghost-button,
        .button-link {
            min-height: 52px;
            padding: 12px 18px;
            border-radius: 999px;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .primary-button {
            background: linear-gradient(135deg, var(--accent), #ff9a74);
            color: #fff;
            font-weight: 700;
            box-shadow: 0 18px 28px rgba(223, 79, 37, 0.18);
        }

        .ghost-button,
        .button-link {
            background: #fff;
            border: 1px solid rgba(27, 35, 44, 0.1);
            color: var(--text);
        }

        .primary-button:hover,
        .ghost-button:hover,
        .button-link:hover {
            transform: translateY(-1px);
        }

        .status {
            min-height: 24px;
            margin: 14px 0 0;
            color: var(--muted);
            line-height: 1.5;
        }

        .status.success {
            color: var(--success);
        }

        .status.error {
            color: var(--danger);
        }

        .result-card,
        .analytics-result {
            margin-top: 18px;
            padding: 20px;
            border-radius: var(--radius-lg);
            background: linear-gradient(180deg, rgba(255, 106, 61, 0.07), rgba(95, 143, 255, 0.05));
            border: 1px solid rgba(255, 106, 61, 0.14);
        }

        .result-card[hidden],
        .analytics-result[hidden] {
            display: none;
        }

        .section-label {
            display: inline-block;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-size: 0.82rem;
            font-weight: 700;
        }

        .result-link {
            display: inline-block;
            margin-top: 10px;
            font-size: 1.04rem;
            font-weight: 700;
            color: var(--accent-deep);
            word-break: break-all;
        }

        .result-link:hover {
            text-decoration: underline;
        }

        .original-url {
            margin: 12px 0 0;
            color: var(--muted);
            line-height: 1.6;
            word-break: break-word;
        }

        .analytics-summary {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-top: 18px;
        }

        .stat-box {
            padding: 18px;
            border-radius: var(--radius-md);
            background: rgba(255, 255, 255, 0.74);
            border: 1px solid rgba(27, 35, 44, 0.08);
        }

        .stat-box span {
            display: block;
            color: var(--muted);
            font-size: 0.84rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
        }

        .stat-box strong {
            display: block;
            margin-top: 8px;
            font-size: 2rem;
            line-height: 1.1;
            word-break: break-word;
        }

        .timeline {
            margin: 18px 0 0;
            padding: 0;
            list-style: none;
            display: grid;
            gap: 10px;
        }

        .timeline li {
            padding: 14px 16px;
            border-radius: var(--radius-md);
            background: rgba(255, 255, 255, 0.72);
            border: 1px solid rgba(27, 35, 44, 0.08);
            color: var(--text);
        }

        .empty-history {
            margin-top: 18px;
            padding: 16px 18px;
            border-radius: var(--radius-md);
            background: rgba(255, 255, 255, 0.72);
            border: 1px dashed rgba(27, 35, 44, 0.14);
            color: var(--muted);
        }

        @media (max-width: 940px) {
            .grid {
                grid-template-columns: 1fr;
            }

            .intro {
                border-right: none;
                border-bottom: 1px solid rgba(27, 35, 44, 0.08);
            }
        }

        @media (max-width: 620px) {
            body {
                padding: 14px;
            }

            .intro,
            .workspace {
                padding: 24px;
            }

            .panel {
                padding: 22px;
            }

            .analytics-summary {
                grid-template-columns: 1fr;
            }

            .button-row,
            .actions {
                flex-direction: column;
                align-items: stretch;
            }

            .primary-button,
            .ghost-button,
            .button-link {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <main class="page">
        <section class="shell">
            <div class="grid">
                <section class="intro">
                    <div>
                        <span class="badge">Smart Links</span>
                        <h1>Shorten it. Share it. Track it.</h1>
                        <p class="intro-copy">
                            Create a short URL in one step, then check click activity anytime with the same clean interface.
                        </p>
                    </div>

                    <div class="info-cards">
                        <div class="info-card">
                            <strong>Create short links fast</strong>
                            <span>Drop any long URL into the form and get a short one back instantly.</span>
                        </div>
                        <div class="info-card">
                            <strong>Check analytics anytime</strong>
                            <span>Paste a short id or short URL to see total clicks and visit history.</span>
                        </div>
                    </div>
                </section>

                <section class="workspace">
                    <article class="panel">
                        <h2>Shorten your URL</h2>
                        <p>Enter the full URL below and generate a short link.</p>

                        <form id="shorten-form" class="form-grid">
                            <label class="field" for="url-input">
                                Long URL
                                <input
                                    id="url-input"
                                    name="url"
                                    type="url"
                                    placeholder="https://example.com/your-long-link"
                                    required
                                >
                            </label>

                            <div class="button-row">
                                <button type="submit" class="primary-button">Generate Short URL</button>
                            </div>
                        </form>

                        <p id="shorten-status" class="status" role="status" aria-live="polite"></p>

                        <section id="shorten-result" class="result-card" hidden>
                            <span class="section-label">Short URL</span>
                            <a id="short-link" class="result-link" href="#" target="_blank" rel="noreferrer"></a>
                            <p id="original-url" class="original-url"></p>

                            <div class="actions">
                                <a id="open-link" class="button-link" href="#" target="_blank" rel="noreferrer">Open Link</a>
                                <button type="button" id="copy-link" class="ghost-button">Copy Link</button>
                                <button type="button" id="use-for-analytics" class="ghost-button">Get Analytics</button>
                            </div>
                        </section>
                    </article>

                    <article class="panel">
                        <h2>Get analytics</h2>
                        <p>Enter a short id like <code>abc12</code> or a short URL like <code>/url/abc12</code>.</p>

                        <form id="analytics-form" class="form-grid">
                            <label class="field" for="analytics-input">
                                Short ID or Short URL
                                <input
                                    id="analytics-input"
                                    name="shortId"
                                    type="text"
                                    placeholder="abc12 or http://localhost:5001/url/abc12"
                                    required
                                >
                            </label>

                            <div class="button-row">
                                <button type="submit" class="primary-button">Fetch Analytics</button>
                            </div>
                        </form>

                        <p id="analytics-status" class="status" role="status" aria-live="polite"></p>

                        <section id="analytics-result" class="analytics-result" hidden>
                            <span class="section-label">Analytics Result</span>

                            <div class="analytics-summary">
                                <div class="stat-box">
                                    <span>Short Path</span>
                                    <strong id="analytics-path">/url/</strong>
                                </div>
                                <div class="stat-box">
                                    <span>Total Clicks</span>
                                    <strong id="analytics-clicks">0</strong>
                                </div>
                            </div>

                            <div class="actions" style="margin-top: 16px;">
                                <a id="analytics-json" class="button-link" href="#" target="_blank" rel="noreferrer">Open Analytics JSON</a>
                            </div>

                            <div id="analytics-empty" class="empty-history" hidden>No visits recorded yet for this short URL.</div>
                            <ul id="analytics-history" class="timeline"></ul>
                        </section>
                    </article>
                </section>
            </div>
        </section>
    </main>

    <script src="/js/home.js"></script>
</body>
</html>
