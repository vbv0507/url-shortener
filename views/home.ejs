<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shorten URL</title>
    <style>
        :root {
            --bg-main: #f7f1e8;
            --bg-soft: #fffaf5;
            --panel: rgba(255, 255, 255, 0.78);
            --panel-strong: rgba(255, 255, 255, 0.92);
            --border: rgba(23, 30, 37, 0.1);
            --text: #1b232c;
            --muted: #68737e;
            --accent: #ff6a3d;
            --accent-deep: #df4f25;
            --success: #1f7a5f;
            --shadow: 0 28px 90px rgba(72, 45, 26, 0.14);
            --radius-xl: 34px;
            --radius-lg: 24px;
            --radius-md: 18px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            padding: 22px;
            font-family: "Segoe UI", "Trebuchet MS", sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at top left, rgba(255, 184, 128, 0.42), transparent 30%),
                radial-gradient(circle at bottom right, rgba(95, 143, 255, 0.16), transparent 26%),
                linear-gradient(145deg, var(--bg-main), var(--bg-soft));
        }

        a {
            color: inherit;
        }

        .page {
            width: min(1100px, 100%);
            margin: 0 auto;
        }

        .hero {
            position: relative;
            overflow: hidden;
            background: var(--panel);
            border: 1px solid rgba(255, 255, 255, 0.74);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow);
            backdrop-filter: blur(14px);
        }

        .hero::before,
        .hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .hero::before {
            width: 260px;
            height: 260px;
            top: -110px;
            right: -80px;
            background: radial-gradient(circle, rgba(255, 106, 61, 0.22), rgba(255, 106, 61, 0));
        }

        .hero::after {
            width: 220px;
            height: 220px;
            bottom: -110px;
            left: -70px;
            background: radial-gradient(circle, rgba(95, 143, 255, 0.16), rgba(95, 143, 255, 0));
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1fr 1.08fr;
            min-height: 760px;
        }

        .intro,
        .workspace {
            padding: 40px;
        }

        .intro {
            border-right: 1px solid rgba(27, 35, 44, 0.08);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            width: fit-content;
            padding: 10px 16px;
            border-radius: 999px;
            background: rgba(27, 35, 44, 0.06);
            color: var(--muted);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        h1,
        h2,
        h3 {
            margin: 0;
            font-family: Georgia, "Times New Roman", serif;
            letter-spacing: -0.05em;
        }

        h1 {
            margin-top: 22px;
            font-size: clamp(3rem, 8vw, 5.6rem);
            line-height: 0.93;
            max-width: 8ch;
        }

        .intro-copy {
            margin: 18px 0 0;
            max-width: 44ch;
            color: var(--muted);
            font-size: 1.02rem;
            line-height: 1.75;
        }

        .info-cards {
            display: grid;
            gap: 14px;
        }

        .info-card {
            padding: 18px 20px;
            border-radius: var(--radius-lg);
            background: rgba(255, 255, 255, 0.58);
            border: 1px solid rgba(27, 35, 44, 0.07);
        }

        .info-card strong {
            display: block;
            margin-bottom: 6px;
            font-size: 1rem;
        }

        .info-card span {
            color: var(--muted);
            line-height: 1.6;
        }

        .workspace {
            display: grid;
            gap: 18px;
            align-content: center;
        }

        .panel {
            position: relative;
            z-index: 1;
            padding: 28px;
            border-radius: 28px;
            background: var(--panel-strong);
            border: 1px solid var(--border);
        }

        .panel p {
            margin: 12px 0 0;
            color: var(--muted);
            line-height: 1.65;
        }

        .form-grid {
            display: grid;
            gap: 14px;
            margin-top: 22px;
        }

        .field {
            display: grid;
            gap: 8px;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--muted);
        }

        .field input {
            width: 100%;
            padding: 17px 18px;
            border-radius: var(--radius-md);
            border: 1px solid rgba(27, 35, 44, 0.12);
            background: #fff;
            color: var(--text);
            font: inherit;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .field input:focus {
            outline: none;
            border-color: rgba(255, 106, 61, 0.45);
            box-shadow: 0 0 0 5px rgba(255, 106, 61, 0.12);
            transform: translateY(-1px);
        }

        .button-row,
        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        button,
        .button-link {
            border: none;
            font: inherit;
            text-decoration: none;
            cursor: pointer;
        }

        .primary-button,
        .button-link.primary {
            min-height: 54px;
            padding: 14px 20px;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--accent), #ff9a74);
            color: #fff;
            font-weight: 700;
            box-shadow: 0 18px 28px rgba(223, 79, 37, 0.18);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .ghost-button,
        .button-link.ghost {
            min-height: 50px;
            padding: 12px 18px;
            border-radius: 999px;
            background: #fff;
            border: 1px solid rgba(27, 35, 44, 0.1);
            color: var(--text);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s ease;
        }

        .primary-button:hover,
        .ghost-button:hover,
        .button-link:hover {
            transform: translateY(-1px);
        }

        .status {
            min-height: 24px;
            margin: 14px 0 0;
            color: var(--muted);
            line-height: 1.5;
        }

        .status[data-state="success"] {
            color: var(--success);
        }

        .status[data-state="error"] {
            color: #c24a30;
        }

        .result-card,
        .analytics-result {
            margin-top: 18px;
            padding: 20px;
            border-radius: var(--radius-lg);
            background: linear-gradient(180deg, rgba(255, 106, 61, 0.07), rgba(95, 143, 255, 0.05));
            border: 1px solid rgba(255, 106, 61, 0.14);
        }

        .section-label {
            display: inline-block;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-size: 0.82rem;
            font-weight: 700;
        }

        .result-link {
            display: inline-block;
            margin-top: 10px;
            font-size: 1.04rem;
            font-weight: 700;
            color: var(--accent-deep);
            word-break: break-all;
        }

        .result-link:hover {
            text-decoration: underline;
        }

        .original-url {
            margin: 12px 0 0;
            color: var(--muted);
            line-height: 1.6;
            word-break: break-word;
        }

        .analytics-summary {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-top: 18px;
        }

        .stat-box {
            padding: 18px;
            border-radius: var(--radius-md);
            background: rgba(255, 255, 255, 0.74);
            border: 1px solid rgba(27, 35, 44, 0.08);
        }

        .stat-box span {
            display: block;
            color: var(--muted);
            font-size: 0.84rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
        }

        .stat-box strong {
            display: block;
            margin-top: 8px;
            font-size: 2rem;
            line-height: 1.1;
            word-break: break-word;
        }

        .timeline {
            margin: 18px 0 0;
            padding: 0;
            list-style: none;
            display: grid;
            gap: 10px;
        }

        .timeline li {
            padding: 14px 16px;
            border-radius: var(--radius-md);
            background: rgba(255, 255, 255, 0.72);
            border: 1px solid rgba(27, 35, 44, 0.08);
            color: var(--text);
        }

        .empty-history {
            margin-top: 18px;
            padding: 16px 18px;
            border-radius: var(--radius-md);
            background: rgba(255, 255, 255, 0.72);
            border: 1px dashed rgba(27, 35, 44, 0.14);
            color: var(--muted);
        }

        @media (max-width: 940px) {
            .hero-grid {
                grid-template-columns: 1fr;
            }

            .intro {
                border-right: none;
                border-bottom: 1px solid rgba(27, 35, 44, 0.08);
            }
        }

        @media (max-width: 620px) {
            body {
                padding: 14px;
            }

            .intro,
            .workspace {
                padding: 24px;
            }

            .panel {
                padding: 22px;
            }

            .analytics-summary {
                grid-template-columns: 1fr;
            }

            .button-row,
            .actions {
                flex-direction: column;
                align-items: stretch;
            }

            .primary-button,
            .ghost-button,
            .button-link {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <main class="page">
        <section class="hero">
            <div class="hero-grid">
                <section class="intro">
                    <div>
                        <span class="badge">Smart Links</span>
                        <h1>Shorten it. Share it. Track it.</h1>
                        <p class="intro-copy">
                            Create a short URL in one step, then check click activity anytime with the same clean interface.
                        </p>
                    </div>

                    <div class="info-cards">
                        <div class="info-card">
                            <strong>Create short links fast</strong>
                            <span>Drop any long URL into the form and get a short one back instantly.</span>
                        </div>
                        <div class="info-card">
                            <strong>Check analytics anytime</strong>
                            <span>Paste a short id or short URL to see total clicks and visit history.</span>
                        </div>
                    </div>
                </section>

                <section class="workspace">
                    <article class="panel">
                        <h2>Shorten your URL</h2>
                        <p>Enter the full URL below and generate a short link.</p>

                        <form id="shorten-form" class="form-grid">
                            <label class="field" for="url-input">
                                Long URL
                                <input
                                    id="url-input"
                                    name="url"
                                    type="url"
                                    placeholder="https://example.com/your-long-link"
                                    required
                                >
                            </label>

                            <div class="button-row">
                                <button type="submit" class="primary-button">Generate Short URL</button>
                            </div>
                        </form>

                        <p id="shorten-status" class="status" role="status" aria-live="polite"></p>

                        <section id="result-card" class="result-card" hidden>
                            <span class="section-label">Short URL</span>
                            <a id="result-link" class="result-link" href="#" target="_blank" rel="noreferrer"></a>
                            <p id="result-original" class="original-url"></p>

                            <div class="actions">
                                <button type="button" id="copy-button" class="ghost-button">Copy Link</button>
                                <a id="open-button" class="button-link ghost" href="#" target="_blank" rel="noreferrer">Open Link</a>
                                <button type="button" id="load-latest-analytics" class="ghost-button">Get Analytics</button>
                            </div>
                        </section>
                    </article>

                    <article class="panel">
                        <h2>Get analytics</h2>
                        <p>Enter a short id like <code>abc12</code> or a short URL like <code>/url/abc12</code>.</p>

                        <form id="analytics-form" class="form-grid">
                            <label class="field" for="analytics-input">
                                Short ID or Short URL
                                <input
                                    id="analytics-input"
                                    name="shortId"
                                    type="text"
                                    placeholder="abc12 or http://localhost:5001/url/abc12"
                                    required
                                >
                            </label>

                            <div class="button-row">
                                <button type="submit" class="primary-button">Fetch Analytics</button>
                            </div>
                        </form>

                        <p id="analytics-status" class="status" role="status" aria-live="polite"></p>

                        <section id="analytics-result" class="analytics-result" hidden>
                            <span class="section-label">Analytics Result</span>

                            <div class="analytics-summary">
                                <div class="stat-box">
                                    <span>Short Path</span>
                                    <strong id="analytics-short-path">/url/</strong>
                                </div>
                                <div class="stat-box">
                                    <span>Total Clicks</span>
                                    <strong id="analytics-click-count">0</strong>
                                </div>
                            </div>

                            <div class="actions" style="margin-top: 16px;">
                                <a id="analytics-json-link" class="button-link ghost" href="#" target="_blank" rel="noreferrer">Open Analytics JSON</a>
                            </div>

                            <div id="empty-history" class="empty-history" hidden>No visits recorded yet for this short URL.</div>
                            <ul id="analytics-history" class="timeline"></ul>
                        </section>
                    </article>
                </section>
            </div>
        </section>
    </main>

    <script>
        const shortenForm = document.getElementById("shorten-form");
        const urlInput = document.getElementById("url-input");
        const shortenStatus = document.getElementById("shorten-status");
        const resultCard = document.getElementById("result-card");
        const resultLink = document.getElementById("result-link");
        const resultOriginal = document.getElementById("result-original");
        const copyButton = document.getElementById("copy-button");
        const openButton = document.getElementById("open-button");
        const latestAnalyticsButton = document.getElementById("load-latest-analytics");

        const analyticsForm = document.getElementById("analytics-form");
        const analyticsInput = document.getElementById("analytics-input");
        const analyticsStatus = document.getElementById("analytics-status");
        const analyticsResult = document.getElementById("analytics-result");
        const analyticsShortPath = document.getElementById("analytics-short-path");
        const analyticsClickCount = document.getElementById("analytics-click-count");
        const analyticsHistory = document.getElementById("analytics-history");
        const analyticsJsonLink = document.getElementById("analytics-json-link");
        const emptyHistory = document.getElementById("empty-history");

        let latestShortId = "";

        function setStatus(element, message, state) {
            element.textContent = message;
            element.dataset.state = state || "";
        }

        async function copyToClipboard(text) {
            await navigator.clipboard.writeText(text);
        }

        function extractShortId(value) {
            const trimmed = value.trim();

            if (!trimmed) {
                return "";
            }

            if (/^https?:\/\//i.test(trimmed)) {
                try {
                    const parsedUrl = new URL(trimmed);
                    const parts = parsedUrl.pathname.split("/").filter(Boolean);
                    return parts[parts.length - 1] || "";
                } catch (error) {
                    return "";
                }
            }

            const parts = trimmed.replace(/^\/+|\/+$/g, "").split("/").filter(Boolean);
            return parts[parts.length - 1] || "";
        }

        function renderAnalytics(shortId, payload) {
            const entries = Array.isArray(payload.analytics) ? payload.analytics.slice().reverse() : [];

            analyticsShortPath.textContent = `/url/${shortId}`;
            analyticsClickCount.textContent = String(payload.totalClicks || 0);
            analyticsJsonLink.href = `/url/analytics/${shortId}`;
            analyticsHistory.innerHTML = "";

            if (!entries.length) {
                emptyHistory.hidden = false;
            } else {
                emptyHistory.hidden = true;
                entries.forEach((entry) => {
                    const item = document.createElement("li");
                    item.textContent = entry.timestamp;
                    analyticsHistory.appendChild(item);
                });
            }

            analyticsResult.hidden = false;
        }

        async function fetchAnalytics(shortId) {
            setStatus(analyticsStatus, "Fetching analytics...", "");

            const response = await fetch(`/url/analytics/${shortId}`);

            let data = {};
            try {
                data = await response.json();
            } catch (parseError) {
                data = {};
            }

            if (!response.ok) {
                throw new Error(data.error || "Unable to fetch analytics right now.");
            }

            renderAnalytics(shortId, data);
            setStatus(analyticsStatus, "Analytics loaded successfully.", "success");
        }

        copyButton.addEventListener("click", async () => {
            try {
                await copyToClipboard(resultLink.href);
                setStatus(shortenStatus, "Short URL copied to clipboard.", "success");
            } catch (error) {
                setStatus(shortenStatus, "Could not copy automatically. You can still copy the link manually.", "error");
            }
        });

        latestAnalyticsButton.addEventListener("click", async () => {
            if (!latestShortId) {
                setStatus(analyticsStatus, "Create a short URL first or enter an existing short id below.", "error");
                return;
            }

            analyticsInput.value = `${window.location.origin}/url/${latestShortId}`;

            try {
                await fetchAnalytics(latestShortId);
            } catch (error) {
                setStatus(analyticsStatus, error.message || "Unable to fetch analytics right now.", "error");
            }
        });

        shortenForm.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (!shortenForm.reportValidity()) {
                setStatus(shortenStatus, "Enter a valid URL before submitting.", "error");
                return;
            }

            const originalUrl = urlInput.value.trim();
            setStatus(shortenStatus, "Generating short URL...", "");

            try {
                const response = await fetch("/url", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ url: originalUrl })
                });

                let data = {};
                try {
                    data = await response.json();
                } catch (parseError) {
                    data = {};
                }

                if (!response.ok) {
                    throw new Error(data.error || "Unable to shorten this URL right now.");
                }

                latestShortId = data.id;
                const shortUrl = `${window.location.origin}/url/${data.id}`;

                resultLink.href = shortUrl;
                resultLink.textContent = shortUrl;
                resultOriginal.textContent = `Original: ${originalUrl}`;
                openButton.href = shortUrl;
                analyticsInput.value = shortUrl;
                resultCard.hidden = false;
                setStatus(shortenStatus, "Short URL created successfully.", "success");

                try {
                    await fetchAnalytics(data.id);
                } catch (error) {
                    setStatus(analyticsStatus, error.message || "Unable to fetch analytics right now.", "error");
                }
            } catch (error) {
                setStatus(shortenStatus, error.message || "Something went wrong while creating the short URL.", "error");
            }
        });

        analyticsForm.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (!analyticsForm.reportValidity()) {
                setStatus(analyticsStatus, "Enter a short id or short URL first.", "error");
                return;
            }

            const shortId = extractShortId(analyticsInput.value);

            if (!shortId) {
                setStatus(analyticsStatus, "Please enter a valid short id or short URL.", "error");
                return;
            }

            try {
                await fetchAnalytics(shortId);
            } catch (error) {
                setStatus(analyticsStatus, error.message || "Unable to fetch analytics right now.", "error");
            }
        });
    </script>
</body>
</html>
