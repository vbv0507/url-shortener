            color: var(--text);
            font-size: 1rem;
            font-weight: 800;
            word-break: break-all;
            text-decoration: none;
        }

        .saved-link-short:hover {
            text-decoration: underline;
        }

        .saved-link-original {
            margin: 10px 0 0;
            color: var(--muted);
            line-height: 1.55;
            word-break: break-word;
        }

        .saved-link-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 12px;
        }

        .saved-link-actions {
            margin-top: 14px;
        }

        .saved-link-actions .secondary-button,
        .saved-link-actions .button-link {
            min-height: 44px;
            padding: 10px 16px;
            font-size: 0.92rem;
        }

        @media (max-width: 920px) {
            .split-grid,
            .dashboard-grid,
            .seo-layout {
                grid-template-columns: 1fr;
            }

            .intro,
            .dashboard-side {
                border-right: none;
                border-bottom: 1px solid rgba(24, 31, 38, 0.08);
            }
        }

        @media (max-width: 620px) {
            body {
                padding: 14px;
            }

            .intro,
            .right-side,
            .dashboard-side,
            .dashboard-work {
                padding: 24px;
            }

            .card {
                padding: 22px;
            }

            .dashboard-title {
                font-size: clamp(2.15rem, 10vw, 3rem);
                line-height: 0.96;
            }

            .switcher,
            .form-row,
            .analytics-summary,
            .dashboard-stats,
            .seo-card-grid,
            .info-list {
                grid-template-columns: 1fr;
                border-radius: 24px;
            }

            .actions,
            .saved-link-top,
            .card-header,
            .result-meta,
            .expiry-head,
            .top-row {
                flex-direction: column;
                align-items: stretch;
            }

            .expiry-options {
                grid-template-columns: 1fr;
            }

            .submit-button,
            .secondary-button,
            .button-link {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <main class="page">
        <section id="auth-view" class="view-shell">
            <div class="split-grid">
                <section class="intro">
                    <div>
                        <span class="pill">Account</span>
                        <h1>Clean short links for every share.</h1>
                        <p class="intro-copy">
                            Convert ugly long links into clean short links in 1 click.
                            urlzap.me is a free URL shortener for students and developers who want to shorten long links fast,
                            including assignment URLs, project links, Render deployments, and Vercel builds.
                            It is also useful for WhatsApp and Telegram users who want cleaner messages, and event organizers sharing forms and registrations.
                        </p>
