                                </linearGradient>
                                <linearGradient id="chartStroke" x1="94" y1="178" x2="406" y2="134" gradientUnits="userSpaceOnUse">
                                    <stop stop-color="#FF7447"/>
                                    <stop offset="1" stop-color="#6E97FF"/>
                                </linearGradient>
                            </defs>

                            <rect x="56" y="40" width="408" height="220" rx="28" fill="url(#projectGlow)"/>

                            <rect x="86" y="74" width="162" height="70" rx="20" fill="white" fill-opacity="0.94" stroke="#F0D8CF"/>
